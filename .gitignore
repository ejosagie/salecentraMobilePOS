# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android release signing
android/key.properties
android/**/*.jks
android/**/*.keystore

# Project-root keystore copies (never commit)
/*.jks
/*.keystore

